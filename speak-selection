"""
Speak selected text using piper TTS with GTK4 window.
This script can be called directly or via keybindings.
"""

import sys
import subprocess
import os
from pathlib import Path

# Prefer Wayland backend for proper transparency/styling
# Must be set BEFORE importing any GTK modules
# On Wayland systems: CSS transparency works correctly
# On X11 systems: Transparency may not work, but app will still function
if os.environ.get('WAYLAND_DISPLAY'):
    # Wayland is available - use it for correct styling
    os.environ['GDK_BACKEND'] = 'wayland'
elif os.environ.get('DISPLAY') and not os.environ.get('GDK_BACKEND'):
    # Only X11 available - warn about potential styling issues
    print("Warning: Running on X11. Window transparency may not work correctly.", 
          file=sys.stderr)

# Add script directory to Python path for imports
SCRIPT_DIR = Path(__file__).parent.resolve()
sys.path.insert(0, str(SCRIPT_DIR))

from get_selected_text import run_clipboard_command
from speak_with_window import SpeakingApp
from tts_piper import PiperTTSProvider


def get_selected_text():
    """Try multiple clipboard/selection tools in priority order."""
    methods = [
        ['xsel', '-p', '-o'],
        ['xsel', '-b', '-o'],
        ['xclip', '-selection', 'primary', '-o'],
        ['xclip', '-selection', 'clipboard', '-o'],
        ['wl-paste', '-p'],
        ['wl-paste'],
    ]
    
    for command in methods:
        text = run_clipboard_command(command)
        if text:
            return text
    
    return None


def main():
    # Get selected text
    text = get_selected_text()
    
    if not text or not text.strip():
        print("No selected text found. Make sure xsel, xclip, or wl-paste is installed.", 
              file=sys.stderr)
        return 1
    
    # Create and validate TTS provider
    tts_provider = PiperTTSProvider()
    if not tts_provider.validate_config():
        print(f"TTS provider '{tts_provider.name}' is not properly configured", 
              file=sys.stderr)
        return 1
    
    # Run GTK app with selected text
    app = SpeakingApp(text.strip(), tts_provider)
    app.run(None)
    
    return 0


if __name__ == "__main__":
    sys.exit(main())
